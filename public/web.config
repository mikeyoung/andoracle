<?xml version="1.0" encoding="UTF-8"?>
<!--
  Andoracle — IIS configuration for the static PWA at /andoracle/.
  The manifest needs an explicit MIME type, and the generated service worker
  must bypass the origin cache so browser update checks receive fresh bytes.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
