{
  "name": "andoracle",
  "private": true,
  "version": "1.0.10",
  "description": "Andoracle is an offline-capable, touch-first duophonic synthesizer PWA that recreates the ARP Odyssey signal flow with MIDI, note sequencing, delay, and patch sharing.",
  "keywords": [
    "synthesizer",
    "duophonic",
    "subtractive-synthesis",
    "web-audio",
    "web-midi",
    "music-sequencer",
    "pwa",
    "arp-odyssey"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run generate:icons",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/verify-precache.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
